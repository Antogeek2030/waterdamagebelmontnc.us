---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { areas } from '../data/areas';

const featuredServices = services.slice(0, 6);
const featuredAreas = areas.slice(0, 4);
---

<BaseLayout
  title="Water Damage Restoration in Belmont, NC"
  description="Fast, professional water damage restoration, flood cleanup, and emergency water removal in Belmont, NC and nearby communities. Call (877) 587-0125."
>
  <section class="hero">
    <div class="container">
      <h1>Water Damage Restoration in Belmont, NC</h1>
      <p>
        When water threatens your home or business, a calm, experienced response matters.
        We provide thorough extraction, structural drying, and careful restoration across Belmont and nearby communities.
      </p>
      <div class="hero-actions">
        <a href={site.phoneHref} class="btn btn-call btn-lg">Call {site.phoneDisplay}</a>
        <a href="/contact/" class="btn btn-primary btn-lg">Get a free assessment</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>How we help</h2>
        <p>From the first call through final drying, we focus on clear communication and practical results.</p>
      </div>
      <div class="process-steps">
        <div class="process-step">
          <h3>Rapid response</h3>
          <p>Call us and we prioritize emergency water situations. We aim to arrive promptly so extraction can begin before damage spreads.</p>
        </div>
        <div class="process-step">
          <h3>Extract & dry</h3>
          <p>We remove standing water, locate hidden moisture, and set up commercial drying equipment until materials reach safe levels.</p>
        </div>
        <div class="process-step">
          <h3>Restore & advise</h3>
          <p>Once dry, we help with cleanup, odor control, and practical next steps so your property can return to normal use.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Services we provide</h2>
        <p>Whether the source is a burst pipe, appliance failure, storm, or flood, we have the process and equipment to help.</p>
      </div>
      <div class="card-grid card-grid-3">
        {featuredServices.map((s) => (
          <article class="card">
            <h3><a href={`/services/${s.slug}/`}>{s.shortTitle}</a></h3>
            <p>{s.description}</p>
            <a href={`/services/${s.slug}/`} class="btn btn-secondary">Learn more</a>
          </article>
        ))}
      </div>
      <p class="text-center" style="margin-top: 2rem;">
        <a href="/services/" class="btn btn-primary">View all services</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Why property owners call us</h2>
        <p>We keep the focus on practical help and honest communication—no exaggerated claims or pressure.</p>
      </div>
      <div class="card-grid card-grid-3">
        <div class="card">
          <h3>Local & responsive</h3>
          <p>Based in Belmont, we understand local conditions and can often reach nearby communities quickly when water is involved.</p>
        </div>
        <div class="card">
          <h3>Thorough drying</h3>
          <p>Removing visible water is only the start. We monitor moisture in structure and materials until drying goals are met.</p>
        </div>
        <div class="card">
          <h3>Clear next steps</h3>
          <p>You will know what we found, what we recommend, and what the work involves before major decisions are made.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>What customers say</h2>
        <p>We appreciate every opportunity to help. Here is the kind of feedback that guides how we work.</p>
      </div>
      <div class="card-grid card-grid-3">
        <blockquote class="card">
          <p>“They arrived the same day our water heater failed and stayed focused until the floors were dry. Straightforward and professional.”</p>
          <footer class="text-muted" style="margin-top: 1rem;">— Homeowner, Belmont</footer>
        </blockquote>
        <blockquote class="card">
          <p>“After a pipe burst while we were away, the team extracted the water, set up drying equipment, and kept us updated. Very helpful through a stressful situation.”</p>
          <footer class="text-muted" style="margin-top: 1rem;">— Property owner, Mount Holly</footer>
        </blockquote>
        <blockquote class="card">
          <p>“Clear explanation of what needed to be done and fair pricing. Would call them again without hesitation.”</p>
          <footer class="text-muted" style="margin-top: 1rem;">— Resident, Cramerton</footer>
        </blockquote>
      </div>
      <p class="text-center text-muted" style="margin-top: 1.5rem; font-size: 0.9rem;">
        These comments reflect typical experiences shared with us. Individual results vary.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Areas we serve</h2>
        <p>Belmont is our primary focus. We also help neighboring communities when travel time allows.</p>
      </div>
      <div class="card-grid card-grid-4">
        {featuredAreas.map((a) => (
          <article class="card">
            <h3><a href={`/areas/${a.slug}/`}>{a.name}</a></h3>
            <p>{a.description}</p>
            <a href={`/areas/${a.slug}/`}>Service details →</a>
          </article>
        ))}
      </div>
      <p class="text-center" style="margin-top: 2rem;">
        <a href="/service-areas/" class="btn btn-secondary">See all service areas</a>
      </p>
    </div>
  </section>

  <CTA />
</BaseLayout>
