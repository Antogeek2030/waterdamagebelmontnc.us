const title = 'Signs of Hidden Water Damage Homeowners Often Miss';
const description = 'Subtle clues that moisture may be present behind walls, under floors, or in crawl spaces—and why early attention helps.';
const pubDate = '2025-10-03';
---

<BaseLayout title={title} description={description} ogType="article">
  <header class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span> / </span>
        <a href="/blog/">Blog</a>
        <span> / </span>
