---
import { site } from '../data/site';
import { services } from '../data/services';
import { areas } from '../data/areas';

const year = new Date().getFullYear();
const topServices = services.slice(0, 6);
const topAreas = areas.slice(0, 6);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h3>{site.name}</h3>
        <p style="margin-bottom: 0.75rem; font-size: 0.95rem;">
          Professional water damage restoration serving Belmont, NC and nearby communities. Fast response when water threatens your property.
        </p>
        <p style="margin-bottom: 0.35rem;">
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </p>
        <p style="margin: 0; font-size: 0.9rem;">
          {site.address.full}
        </p>
      </div>
      <div>
        <h3>Services</h3>
        <ul class="footer-links">
          {topServices.map((s) => (
            <li><a href={`/services/${s.slug}/`}>{s.shortTitle}</a></li>
          ))}
          <li><a href="/services/">View all services</a></li>
        </ul>
      </div>
      <div>
        <h3>Service Areas</h3>
        <ul class="footer-links">
          {topAreas.map((a) => (
            <li><a href={`/areas/${a.slug}/`}>{a.name}</a></li>
          ))}
          <li><a href="/service-areas/">All areas</a></li>
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul class="footer-links">
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p style="margin: 0;">© {year} {site.name}. All rights reserved.</p>
      <p style="margin: 0;">
        <a href="/privacy-policy/">Privacy</a>
        {' · '}
        <a href="/terms/">Terms</a>
      </p>
    </div>
  </div>
</footer>
